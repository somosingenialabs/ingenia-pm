# Caddy: recibe 80/443, saca el certificado HTTPS solo (Let's Encrypt) y reparte por nombre.
# {$DOMINIO} sale del .env. Dentro de Docker se usan nombres de servicio, nunca localhost.
# Ejemplo: app.{$DOMINIO} = la app. Si Supabase es self-hosted, api.{$DOMINIO} = Kong.

(comun) {
	encode zstd gzip
	header -Server
}

app.{$DOMINIO} {
	import comun
	reverse_proxy app:3000
}

# Solo con Supabase self-hosted. Con Supabase en la nube, borrá este bloque.
api.{$DOMINIO} {
	import comun
	reverse_proxy kong:8000
}
