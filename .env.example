# Copiar a .env.local y completar con lo que muestra `npx supabase status` (Supabase local).
# .env.local no se sube al repo.

# Públicas (van al navegador): URL de la API y clave anónima ("anon key" / "publishable key").
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: SOLO en el servidor, después de verificar el rol (service_role / secret key).
SUPABASE_SECRET_KEY=

# Solo para npm run test:sql. Es la base local, con la clave de fábrica de Supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
